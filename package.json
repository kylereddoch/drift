{
  "name": "drift-mastodon",
  "version": "1.0.0",
  "private": true,
  "description": "Share a page, a passage, a good find. A privacy-conscious Mastodon sharing extension.",
  "type": "module",
  "license": "MIT",
  "author": "Kyle Reddoch",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "node scripts/check.mjs",
    "icons": "node scripts/icons.mjs",
    "package": "node scripts/package.mjs",
    "store": "node scripts/package.mjs && node scripts/store-assets.mjs",
    "verify": "npm run check && npm test && npm run test:browser && npm run package"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "fflate": "0.8.3"
  }
}
